# Copy to `.env.local` and fill in the values you need.
# See web/README.md for what each variable does.
#
# Every value below is empty on purpose, and this is the only tracked env file
# in the repo. It is deliberately *not* allowlisted in /.gitleaks.toml, so a real
# value pasted here fails the gitleaks job in
# .github/workflows/secrets-guard.yml. That is the point of the file, not an
# inconvenience: this is where a real key gets pasted by accident.
#
# Each variable carries a `# public` or `# secret` marker. `public` means the
# value is inlined into the client bundle at build time and is readable by
# anyone; `secret` means server-only, and must never gain a NEXT_PUBLIC_ prefix.
# The same split, with blast radius, is tabulated in web/README.md under
# "Environment variables in production" and in docs/runbooks/rotate-credentials.md.

# Mapbox — required for the interactive globe on /globe
# public
NEXT_PUBLIC_MAPBOX_TOKEN=

# Clerk — optional; both keys are required to enable sign-in on /my.
# The auth routes and post-sign-in redirect are wired in code (middleware.ts and
# components/hq/auth-screen.tsx), so no NEXT_PUBLIC_CLERK_*_URL vars are needed.
# This app stays on `middleware.ts` rather than Next 16's `proxy.ts` on purpose;
# see the comment at the top of middleware.ts.
# public
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# secret
CLERK_SECRET_KEY=

# Supabase — optional; the URL plus at least one key persists trackers and wins
# to an account instead of the browser. Server-only on purpose: no NEXT_PUBLIC_
# prefix on any of these. Clerk must be configured too, or there is no user to
# attribute a saved hackathon to.
# Project URL and keys: Supabase dashboard -> Project Settings -> API.
# secret
SUPABASE_URL=

# Preferred: the publishable (anon) key. Setting it flips tracker writes onto
# the caller's Clerk token, so Postgres RLS enforces row ownership instead of
# app code. Requires the Clerk JWT template named "supabase" (with
# {"role":"authenticated"}) and Clerk registered as a third-party auth provider
# in Supabase; see web/README.md for the flip procedure.
# secret
SUPABASE_ANON_KEY=

# Legacy fallback: service mode. Bypasses RLS, so ownership is enforced by
# lib/tracker-store.ts instead. Ignored when SUPABASE_ANON_KEY is set, and can
# be removed from the runtime env once token mode is verified. Highest blast
# radius of anything here — rotate it first if there is any doubt.
# secret
SUPABASE_SERVICE_ROLE_KEY=

# PostHog — optional; cookieless, anonymous product analytics. Leave unset and
# analytics is fully off (posthog-js is never even downloaded). The host only
# matters if the project lives on a non-US PostHog cloud or a reverse proxy;
# it defaults to https://us.i.posthog.com.
# public
NEXT_PUBLIC_POSTHOG_KEY=
# public
NEXT_PUBLIC_POSTHOG_HOST=

# Drizzle/Supabase Postgres — only needed when running npm run db:* scripts.
# Use the direct or pooled Postgres connection string from Supabase. Either name
# works; drizzle.config.ts reads DATABASE_URL first and falls back to
# SUPABASE_DATABASE_URL. Set one, not both. A connection string embeds the
# database password, so it is the most dangerous value in this file after the
# service role key.
# secret
DATABASE_URL=
# secret
SUPABASE_DATABASE_URL=

# Repo identity — optional; only needed on a fork, so the GitHub links and raw
# data URLs point at your own repository instead of Hack-HQ/hackhq. Read by
# lib/repo.ts and next.config.ts, both of which default to Hack-HQ/hackhq.
# public
NEXT_PUBLIC_REPO_SLUG=
