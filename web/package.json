{
  "name": "web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "copy-assets": "node scripts/copy-repo-assets.mjs",
    "prepare-data": "node scripts/prepare-repo-data.mjs",
    "predev": "node scripts/copy-repo-assets.mjs && node scripts/prepare-repo-data.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-repo-assets.mjs && node scripts/prepare-repo-data.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/prepare-repo-data.mjs",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.2",
    "mapbox-gl": "^3.25.0",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "posthog-js": "^1.416.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "^8.5.12",
    "sharp": "^0.35.0",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3",
    "esbuild": "^0.25.0"
  }
}
